{
  "name": "mf-vite-dev-transitive-import-false-share-repro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build:provider": "pnpm --filter @repro/provider build",
    "dev": "pnpm run build:provider && pnpm --filter @repro/consumer dev",
    "repro": "pnpm run build:provider && node scripts/browser-check.mjs",
    "repro:workaround": "pnpm run build:provider && REPRO_SEED_SHARED_CACHE=1 node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  }
}
